HF_TOKEN=replace-with-your-hugging-face-token
HF_HOME=/mnt/nvme/hf

SDXL_BIND_HOST=0.0.0.0
SDXL_PORT=8090
SDXL_MODEL_RESOLUTION=1024
SDXL_IP_ADAPTER_SCALE=0.7
SDXL_CONTROLNET_SCALE=0.7

SDXL_DEPTH_MODEL=depth-anything/Depth-Anything-V2-Small-hf
SDXL_CONTROLNET_MODEL=diffusers/controlnet-depth-sdxl-1.0
SDXL_IP_ADAPTER_REPO=h94/IP-Adapter
SDXL_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# Set to 1 only after every model is present in HF_HOME.
HF_HUB_OFFLINE=0
