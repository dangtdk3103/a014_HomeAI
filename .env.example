DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

GOOGLE_CLOUD_PROJECT=your-google-cloud-project
# Optional when Application Default Credentials are unavailable.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repo/service-account.json
GEMINI_PROMPT_MODEL=gemini-2.5-flash-lite
GEMINI_PROMPT_LOCATION=us-central1
GEMINI_ANALYZE_MODEL=gemini-3.1-flash-lite
GEMINI_ANALYZE_LOCATION=global

# Optional external fallback services.
FLASK_NEST_URL=http://127.0.0.1:8090
SDXL_NEST_URL=http://127.0.0.1:8090

# Defaults to ./config/nest when omitted.
# NEST_CONFIG_DIR=/absolute/path/to/nest-config

# Required for gated Hugging Face model downloads.
HF_TOKEN=replace-with-your-hugging-face-token

# Used only by run_forever.sh.
DJANGO_BIND=0.0.0.0:8000
